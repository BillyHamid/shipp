# ── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# ── Database (Postgres) ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://gsg:gsg_dev_password@localhost:5433/gsg_logistique?schema=public

# ── Redis (cache + WS adapter + BullMQ) ─────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Auth ────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_ACCESS_SECRET=change_me_in_production_use_64_random_bytes_minimum
JWT_REFRESH_SECRET=change_me_too_in_production_use_64_different_random_bytes
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ── QR code signing ─────────────────────────────────────────────────────────
QR_HMAC_SECRET=change_me_qr_signing_secret_32_bytes_random

# ── CORS ────────────────────────────────────────────────────────────────────
ADMIN_ORIGIN=http://localhost:5173
TRACKING_ORIGIN=http://localhost:3001
SCAN_ORIGIN=http://localhost:5174
# Production frontends, comma-separated. Example:
# ALLOWED_ORIGINS=https://gsg-admin.vercel.app,https://gsg-track.vercel.app,https://gsg-scan.vercel.app
ALLOWED_ORIGINS=

# ── Public tracking URL (used in QR codes and notifications) ────────────────
PUBLIC_TRACKING_URL=http://localhost:3001

# ── Exchange rate (fallback if no API configured) ──────────────────────────
EXCHANGE_RATE_USD_XOF=563

# ── SMS gateway (Aqilas) ─────────────────────────────────────────────────
AQILAS_API_URL=https://www.aqilas.com/api/v1
AQILAS_API_TOKEN=
AQILAS_SENDER_ID=
