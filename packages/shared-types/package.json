{
  "name": "@gsg/shared-types",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/cjs/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/esm/index.d.ts", "default": "./dist/esm/index.js" },
      "require": { "types": "./dist/cjs/index.d.ts", "default": "./dist/cjs/index.js" }
    },
    "./domain": {
      "import": { "types": "./dist/esm/domain.d.ts", "default": "./dist/esm/domain.js" },
      "require": { "types": "./dist/cjs/domain.d.ts", "default": "./dist/cjs/domain.js" }
    },
    "./permissions": {
      "import": { "types": "./dist/esm/permissions.d.ts", "default": "./dist/esm/permissions.js" },
      "require": { "types": "./dist/cjs/permissions.d.ts", "default": "./dist/cjs/permissions.js" }
    },
    "./schemas": {
      "import": { "types": "./dist/esm/schemas.d.ts", "default": "./dist/esm/schemas.js" },
      "require": { "types": "./dist/cjs/schemas.d.ts", "default": "./dist/cjs/schemas.js" }
    },
    "./events": {
      "import": { "types": "./dist/esm/events.d.ts", "default": "./dist/esm/events.js" },
      "require": { "types": "./dist/cjs/events.d.ts", "default": "./dist/cjs/events.js" }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.esm.json && node -e \"require('fs').writeFileSync('dist/esm/package.json', '{\\\"type\\\":\\\"module\\\"}')\"",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0"
  }
}
